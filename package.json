{
  "name": "wallet-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Manual wallet, credit card, loan and budget tracker (PWA) hosted on GitHub Pages",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=4 \"tests/**/*.test.*\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:ui": "node --test \"tests/ui/*.test.cjs\"",
    "test:layout": "node --test \"tests/layout/*.test.cjs\"",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "jsdom": "24.1.0",
    "playwright": "1.48.2",
    "vite": "^5.4.11"
  },
  "type": "module"
}
